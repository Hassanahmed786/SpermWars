# FRONTEND
# Frontend variables are prefixed with NEXT_PUBLIC_

# MONAD
# Required: The network to use ("testnet" or "mainnet")
NEXT_PUBLIC_MONAD_NETWORK=testnet
# Optional overrides (defaults come from official Monad docs):
#   Testnet: https://testnet-rpc.monad.xyz  · explorer https://testnet.monadexplorer.com  · chain 10143
#   Mainnet: https://rpc.monad.xyz          · explorer https://monadexplorer.com          · chain 143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER=https://testnet.monadexplorer.com

# WALLET
# Optional: Get a project id from https://cloud.reown.com to enable WalletConnect QR.
# Without it, the modal clearly shows WalletConnect as "requires configuration".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# CONTRACTS
# Address of the deployed SpermWarsMonad contract (leave unset to disable on-chain records)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Sink/burn address used by the optional on-chain Monad Blast demo transaction.
# Defaults to the standard burn address if unset.
NEXT_PUBLIC_MON_SINK=0x000000000000000000000000000000000000dEaD

# Cost of the on-chain Monad Blast, in MON.
NEXT_PUBLIC_BLAST_COST=0.001

# BACKEND / SERVER
# Server Port (default 3000)
PORT=3000
# Node environment
NODE_ENV=production

# SERVER SECRETS
# Secret: Contract owner key — SERVER-SIDE ONLY. Never expose to the client, never commit.
# Required for server-side contract interactions (e.g. issuing rewards if implemented).
CONTRACT_OWNER_KEY=
